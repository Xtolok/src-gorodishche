\pard\plain \fi720\qj\hyphpar1 \f4\fs24 \cs65552\f4\fs24 7. {\field{\*\fldinst {HYPERLINK "http://ivo.garant.ru/document?id=1252264&sub=1"}}{\fldrslt {\cs24\b0\cf18 Примерные положения}}} о специализированных учреждениях для несовершеннолетних, нуждающихся в социальной реабилитации, утверждаются уполномоченным Правительством Российской Федерации федеральным органом исполнительной власти.\par\pard
